# =============================================================================
# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces around commas)
# Example: mysite.com,www.mysite.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of full origins Django accepts CSRF tokens from.
# Must include the scheme (https://).
# Example: https://mysite.com,https://www.mysite.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mysite.com

# Logging level for the django logger: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=INFO
