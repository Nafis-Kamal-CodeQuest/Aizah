# =============================================================================
# Copy this file to .env and fill in the values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces around commas)
# Example: mysite.com,www.mysite.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of full origins Django accepts CSRF tokens from.
# Must include the scheme (https://).
# Example: https://mysite.com,https://www.mysite.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mysite.com

# Logging level for the django logger: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=INFO

# =============================================================================
# Google Sheets Integration (careers application auto-sync)
# =============================================================================

# The spreadsheet ID — found in the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Path to your service account JSON key file (recommended for cPanel/VPS):
#   GOOGLE_SERVICE_ACCOUNT_JSON=/home/username/private/service-account.json
#
# Alternatively, paste the entire JSON contents as a single line (useful for
# hosts that only allow env vars, not file uploads):
#   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/your/service-account-key.json
